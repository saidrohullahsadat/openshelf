{
  "name": "open-shelf-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "storage:migrate:blob": "node scripts/migrate-books-to-blob.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^4.7.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": "^0.3.6"
  }
}
