NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/openshelf?sslmode=require
DATABASE_POOL_MAX=5
SESSION_DAYS=14
SESSION_COOKIE_SAMESITE=lax
MAX_UPLOAD_MB=50
STORAGE_DIR=./storage
FREE_DOWNLOADS=3
CONTRIBUTIONS_PER_UNLOCK=3
DOWNLOADS_PER_UNLOCK=10
ALLOW_REPEAT_DOWNLOAD=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-password
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
CORS_ORIGINS=
VITE_API_BASE=/api/v1
VITE_BLOB_CLIENT_UPLOADS=false
BLOB_READ_WRITE_TOKEN=
GEMINI_API_KEY=
GEMINI_FILE_SEARCH_STORE_NAME=
GEMINI_MODEL=gemini-2.5-flash
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
